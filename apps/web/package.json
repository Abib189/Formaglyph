{
  "name": "@formaglyph/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "libraries": "node --import tsx scripts/build-libraries.mjs",
    "downloads:react": "pnpm --filter @formaglyph/react build && node scripts/build-react-downloads.mjs",
    "dev": "pnpm downloads:react && pnpm libraries && vite",
    "build": "pnpm downloads:react && pnpm libraries && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm downloads:react && pnpm libraries && vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "preview": "vite preview",
    "smoke:downloads": "node scripts/smoke-react-downloads.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@formaglyph/icons": "workspace:*",
    "@formaglyph/react": "workspace:*",
    "@formaglyph/schema": "workspace:*",
    "@formaglyph/validators": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "2.110.7",
    "@vitejs/plugin-react": "5.0.4",
    "morphicons": "^1.6.0",
    "motion": "14.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@iconify-json/bi": "1.2.7",
    "@iconify-json/feather": "1.2.1",
    "@iconify-json/fluent": "1.2.60",
    "@iconify-json/healthicons": "1.2.14",
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/hugeicons": "1.2.35",
    "@iconify-json/iconoir": "1.2.12",
    "@iconify-json/ion": "1.2.7",
    "@iconify-json/lucide": "1.2.137",
    "@iconify-json/material-symbols": "1.2.96",
    "@iconify-json/octicon": "1.2.40",
    "@iconify-json/radix-icons": "1.2.6",
    "@iconify-json/simple-icons": "1.2.100",
    "@iconify-json/tabler": "1.2.41",
    "@phosphor-icons/core": "2.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "happy-dom": "21.0.4",
    "simple-icons": "16.35.0",
    "tsx": "4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
